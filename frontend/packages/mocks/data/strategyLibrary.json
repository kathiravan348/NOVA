      "name": "IBS reversion",
      "summary": "Buy a close in the bottom 15% of the day's range in an uptrend; sell a close in the top 20%.",
      "spec": {
        "mode": "python",
        "segment": "equity_delivery",
        "exchange": "NSE",
        "timeframe": "1d",
        "sizing": {
          "type": "percent_equity",
          "percent": 10
        },
        "risk": {
          "stopLossPercent": 8,
          "targetPercent": null,
          "maxHoldBars": 10
        },
        "portfolio": {
          "maxPositions": 10,
          "rank": {
            "by": {
              "kind": "indicator",
              "name": "roc",
              "params": {
                "period": 126
              }
            },
            "order": "desc"
          }
        },
        "regime": {
          "index": "NIFTY 50",
          "condition": {
            "left": {
              "kind": "price",
              "field": "close"
            },
            "op": "gt",
            "right": {
              "kind": "indicator",
              "name": "sma",
              "params": {
                "period": 200
              }
            }
          },
          "whenOff": "no_new_entries"
        },
        "code": "class Strategy:\n    def on_bar(self, ctx):\n        trend = ctx.sma(200)\n        if trend is None:\n            return None\n        spread = ctx.high - ctx.low\n        ibs = (ctx.close - ctx.low) / spread if spread > 0 else 0.5\n        if ibs > 0.8:\n            return \"exit\"\n        if ibs < 0.15 and ctx.close > trend:\n            return \"enter\"\n        return None\n"
      },
