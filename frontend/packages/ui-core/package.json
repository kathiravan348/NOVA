    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}

