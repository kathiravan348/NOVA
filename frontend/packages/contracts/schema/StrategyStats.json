{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategyId": {
      "type": "string",
      "minLength": 1
    },
    "runsTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runsCompleted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runsFailed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runsInProgress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastRunAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "bestReturnPercent": {
      "type": [
        "number",
        "null"
      ]
    },
    "worstReturnPercent": {
      "type": [
        "number",
        "null"
      ]
    },
    "winRateMinPercent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "winRateMaxPercent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "worstDrawdownPercent": {
      "anyOf": [
        {
          "type": "number",
          "maximum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "bestNetPnl": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "runId": {
              "type": "string",
              "minLength": 1
            },
            "netPnlPaise": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "runId",
            "netPnlPaise"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "strategyId",
    "runsTotal",
    "runsCompleted",
    "runsFailed",
    "runsInProgress",
    "lastRunAt",
    "bestReturnPercent",
    "worstReturnPercent",
    "winRateMinPercent",
    "winRateMaxPercent",
    "worstDrawdownPercent",
    "bestNetPnl"
  ],
  "additionalProperties": false
}
