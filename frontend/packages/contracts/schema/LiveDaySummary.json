{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Z0-9&]+(?:-[A-Z0-9&]+)*$"
    },
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "tickCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "secondsExpected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22500
    },
    "missingSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "noTradeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "symbol",
    "day",
    "tickCount",
    "candleCount",
    "secondsExpected",
    "missingSeconds",
    "noTradeSeconds",
    "sizeBytes"
  ],
  "additionalProperties": false
}
