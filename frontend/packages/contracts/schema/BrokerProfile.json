{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "broker": {
      "type": "string",
      "const": "zerodha"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "string",
      "minLength": 1
    },
    "subscriptionRenewsOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "apiKeyLast4": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{4}$"
    },
    "redirectUrl": {
      "type": "string",
      "format": "uri"
    },
    "postbackUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "staticIp": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionRule": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "docs",
              "rate_limits",
              "console",
              "forum",
              "charges",
              "client_library",
              "other"
            ]
          }
        },
        "required": [
          "label",
          "url",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "broker",
    "name",
    "api",
    "plan",
    "subscriptionRenewsOn",
    "apiKeyLast4",
    "redirectUrl",
    "postbackUrl",
    "staticIp",
    "sessionRule",
    "links"
  ],
  "additionalProperties": false
}
