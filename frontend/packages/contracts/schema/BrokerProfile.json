{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "broker": {
      "type": "string",
      "const": "zerodha"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "string",
      "minLength": 1
    },
    "sessionRule": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "docs",
              "rate_limits",
              "console",
              "forum",
              "charges",
              "client_library",
              "other"
            ]
          }
        },
        "required": [
          "label",
          "url",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "broker",
    "name",
    "api",
    "sessionRule",
    "links"
  ],
  "additionalProperties": false
}
