{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ]
    },
    "strategyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "universe": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "symbols"
            },
            "symbols": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "type",
            "symbols"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "index"
            },
            "index": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[A-Z0-9 &-]+$"
            }
          },
          "required": [
            "type",
            "index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "initialCapitalPaise": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "benchmark": {
      "anyOf": [
        {
          "type": "string",
          "const": "NIFTY 50"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "reportKept": {
      "type": "boolean"
    },
    "metrics": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "grossPnlPaise": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "chargesPaise": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "netPnlPaise": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "returnPercent": {
              "type": "number"
            },
            "cagrPercent": {
              "type": "number"
            },
            "maxDrawdownPercent": {
              "type": "number",
              "maximum": 0
            },
            "sharpe": {
              "type": "number"
            },
            "winRatePercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "tradeCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "winCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lossCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "benchmarkReturnPercent": {
              "type": [
                "number",
                "null"
              ]
            },
            "benchmarkCagrPercent": {
              "type": [
                "number",
                "null"
              ]
            },
            "exposurePercent": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "avgHoldDays": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "profitFactor": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "calmar": {
              "type": [
                "number",
                "null"
              ]
            },
            "estimatedTaxPaise": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "afterTaxNetPnlPaise": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "afterTaxCagrPercent": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "grossPnlPaise",
            "chargesPaise",
            "netPnlPaise",
            "returnPercent",
            "cagrPercent",
            "maxDrawdownPercent",
            "sharpe",
            "winRatePercent",
            "tradeCount",
            "winCount",
            "lossCount",
            "benchmarkReturnPercent",
            "benchmarkCagrPercent",
            "exposurePercent",
            "avgHoldDays",
            "profitFactor",
            "calmar",
            "estimatedTaxPaise",
            "afterTaxNetPnlPaise",
            "afterTaxCagrPercent"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "runId",
    "version",
    "status",
    "strategyVersion",
    "name",
    "universe",
    "from",
    "to",
    "initialCapitalPaise",
    "benchmark",
    "createdAt",
    "error",
    "reportKept",
    "metrics"
  ],
  "additionalProperties": false
}
