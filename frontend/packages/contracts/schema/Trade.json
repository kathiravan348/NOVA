{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "exchange": {
      "type": "string",
      "enum": [
        "NSE",
        "NFO"
      ]
    },
    "segment": {
      "type": "string",
      "enum": [
        "equity_delivery",
        "equity_intraday",
        "futures",
        "options"
      ]
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "qty": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "entryAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "entryPricePaise": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "exitAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "exitPricePaise": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "grossPnlPaise": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "charges": {
      "type": "object",
      "properties": {
        "brokeragePaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sttPaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exchangeTxnPaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sebiFeePaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stampDutyPaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gstPaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dpPaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPaise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "brokeragePaise",
        "sttPaise",
        "exchangeTxnPaise",
        "sebiFeePaise",
        "stampDutyPaise",
        "gstPaise",
        "dpPaise",
        "totalPaise"
      ],
      "additionalProperties": false
    },
    "netPnlPaise": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "runId",
    "symbol",
    "exchange",
    "segment",
    "side",
    "qty",
    "entryAt",
    "entryPricePaise",
    "exitAt",
    "exitPricePaise",
    "grossPnlPaise",
    "charges",
    "netPnlPaise"
  ],
  "additionalProperties": false
}
