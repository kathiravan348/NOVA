{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "symbols": {
      "maxItems": 3000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9&-]{1,20}$"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "off",
        "waiting",
        "recording",
        "no_login"
      ]
    },
    "jobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "enabled",
    "symbols",
    "state",
    "jobId",
    "updatedAt"
  ],
  "additionalProperties": false
}
