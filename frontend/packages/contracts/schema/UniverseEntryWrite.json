{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9&-]{1,20}$"
    },
    "name": {
      "type": "string",
      "maxLength": 80,
      "pattern": "\\S"
    },
    "sector": {
      "type": "string",
      "maxLength": 80,
      "pattern": "\\S"
    },
    "indices": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "NIFTY 50",
          "NIFTY BANK",
          "NIFTY NEXT 50"
        ]
      }
    }
  },
  "required": [
    "symbol",
    "name",
    "sector",
    "indices"
  ],
  "additionalProperties": false
}
