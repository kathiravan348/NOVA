{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "stocksChecked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stocksSkipped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "closeMatchPercent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "rangeOkPercent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "volumeMatchPercent": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "clockOffsetSeconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "stocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Z0-9&]+(?:-[A-Z0-9&]+)*$"
          },
          "minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "closeMatchPercent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "rangeOkPercent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "volumeMatchPercent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "symbol",
          "minutes",
          "closeMatchPercent",
          "rangeOkPercent",
          "volumeMatchPercent"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "day",
    "stocksChecked",
    "stocksSkipped",
    "minutes",
    "closeMatchPercent",
    "rangeOkPercent",
    "volumeMatchPercent",
    "clockOffsetSeconds",
    "warnings",
    "checkedAt",
    "stocks"
  ],
  "additionalProperties": false
}
