{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "frontend", "storybook", "--no-open", "--ci"],
      "port": 6006
    },
    {
      "name": "storybook-review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../Nova-review/frontend/packages/ui-storybook",
