# Copy to .env (git-ignored) and change the password. Never commit .env.
# PostgreSQL + TimescaleDB (compose service "db")
POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nova

# Host ports (all bound to 127.0.0.1)
NOVA_DB_PORT=5432
NOVA_REDIS_PORT=6379
NOVA_CORE_PORT=8000

# Service log level: debug | info | warning | error
NOVA_LOG_LEVEL=info

# Shared secret NOVA Core sends to services (D38). Use a long random value, e.g. 48+ characters.
NOVA_INTERNAL_TOKEN=change-me-to-a-long-random-value
# true when served over https (VPS); false for local http
NOVA_COOKIE_SECURE=false

# Kite Connect (broker service only, D35). Leave empty until you have the paid API key.
NOVA_KITE_API_KEY=
NOVA_KITE_API_SECRET=
# Encrypts Kite access tokens at rest (D39). Create one with:
#   docker compose run --rm broker python -m nova_broker new-token-key
NOVA_BROKER_TOKEN_KEY=
# Must match the redirect URL registered in the Kite developer console.
NOVA_KITE_REDIRECT_URL=http://localhost:3001/api/v1/broker/kite/callback
# Optional profile facts shown in Relay: renewal date (YYYY-MM-DD) and registered static IP.
NOVA_KITE_RENEWS_ON=
NOVA_KITE_STATIC_IP=
NOVA_RELAY_URL=http://localhost:3001
# When Kite per-day limits reset, IST HH:MM (D40). Not documented by Kite; confirm with Zerodha.
NOVA_KITE_DAILY_RESET=00:00
